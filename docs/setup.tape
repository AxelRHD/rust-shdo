# Records docs/setup.gif (first start) – run via `mise run docs:gif`.

Output docs/setup.gif

Set Shell "bash"
Set FontSize 14
Set Width 1400
Set Height 520
Set Padding 16
Set Theme "nord"
Set TypingSpeed 50ms

Hide
Type "unset LC_ALL LC_MESSAGES SHDO_CONFIG_DIR XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME; export PS1='$ ' LANG=en_US.UTF-8 HOME=$SHDO_GIF_SETUP_HOME PATH=$SHDO_GIF_SETUP_BIN:$PATH"
Enter
Type "clear"
Enter
Show

Type "shdo"
Enter
Sleep 2s

# Language: the dialog switches while you move
Down
Sleep 1.4s
Up
Sleep 900ms
Enter
Sleep 1.5s

# Data directory (default), buckets (home and work)
Enter
Sleep 1.5s
Enter
Sleep 1.2s

# Holidays: Germany, Baden-Württemberg
Down
Sleep 800ms
Enter
Sleep 1.2s
Enter
Sleep 1.2s

# Summary, then the board
Sleep 1.5s
Enter
Sleep 2.5s
Type "q"
Sleep 500ms
