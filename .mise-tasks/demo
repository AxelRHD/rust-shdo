#!/usr/bin/env bash
#MISE description="TUI mit Beispieldaten in target/demo starten (--reset legt Daten und Demo-Config neu an)"
set -euo pipefail
cd "$MISE_PROJECT_ROOT"
dir="$MISE_PROJECT_ROOT/target/demo"
# Eigene shdo-Config, damit Theme-Wechsel o. Ä. nicht in ~/.config/shdo landen.
# Bewusst nicht XDG_CONFIG_HOME: das würde auch den Editor ohne seine Config starten.
export SHDO_CONFIG_DIR="$MISE_PROJECT_ROOT/target/demo-config"
cargo build -q
shdo=(./target/debug/shdo --dir "$dir")
if [[ "${1:-}" == "--reset" ]]; then rm -rf "$dir" "$SHDO_CONFIG_DIR"; fi
if [[ ! -d "$dir/tasks" ]]; then
  "${shdo[@]}" init >/dev/null
  printf '\n[[buckets]]\nkey = "home"\nname = "Privat"\n\n[[buckets]]\nkey = "work"\nname = "Arbeit"\n' >> "$dir/shdo.toml"
  "${shdo[@]}" Rechnung bezahlen P1 due:morgen @home >/dev/null
  id=$("${shdo[@]}" Steuererklärung abgeben P1 due:+3d @home | cut -d' ' -f1)
  printf '\nUnterlagen im Ordner „Steuer 2025“.\n\n- [x] Belege sammeln\n- [ ] Anlage N\n- [ ] abschicken\n' >> "$dir/tasks/$id.md"
  "${shdo[@]}" Reifen wechseln due:sa @home >/dev/null
  "${shdo[@]}" Keller aufräumen P3 >/dev/null
  "${shdo[@]}" Zahnarzt anrufen due:heute @home >/dev/null
  "${shdo[@]}" Abo kündigen P2 due:2020-01-01 >/dev/null
  id=$("${shdo[@]}" Angebot schreiben P2 due:fr @work | cut -d' ' -f1); "${shdo[@]}" mv "$id" doing >/dev/null
  id=$("${shdo[@]}" Antwort vom Vermieter @home | cut -d' ' -f1); "${shdo[@]}" mv "$id" wait >/dev/null
  id=$("${shdo[@]}" Paket zur Post | cut -d' ' -f1); "${shdo[@]}" done "$id" >/dev/null
  "${shdo[@]}" Quartalsbericht P1 due:+1w @work >/dev/null
  "${shdo[@]}" Meeting vorbereiten due:mo @work >/dev/null
  echo "✅ Beispieldaten in $dir"
fi
exec "${shdo[@]}"
